# Renomeie para "secrets.toml" e preencha.
# NÃO versione o secrets.toml nem o .json (já estão no .gitignore).

# ---------------------------------------------------------------------------
# OPÇÃO A (mais fácil, uso local): use o arquivo .json da service account.
#   1) Baixe a chave JSON no Google Cloud.
#   2) Coloque o arquivo nesta pasta (STREAMLIT/). Qualquer nome .json serve;
#      o app encontra automaticamente. Opcionalmente aponte o nome abaixo.
#   3) Preencha só o spreadsheet_id.
# ---------------------------------------------------------------------------
[app]
spreadsheet_id = "COLE_AQUI_O_ID_DA_PLANILHA"   # parte da URL entre /d/ e /edit
# service_account_file = "minha-chave.json"      # opcional (senão detecta sozinho)
# base_url = "https://seu-app.streamlit.app"     # URL pública p/ o QR do romaneio
                                                 # (local: http://localhost:8501)

# ---------------------------------------------------------------------------
# OPÇÃO B (para Streamlit Cloud): cole os campos do JSON aqui.
# No deploy não dá para subir arquivo, então use esta seção.
# Atenção ao private_key: mantenha os \n exatamente como no JSON.
# ---------------------------------------------------------------------------
# [gcp_service_account]
# type = "service_account"
# project_id = "seu-projeto"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
# client_email = "portal-leves@seu-projeto.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
# universe_domain = "googleapis.com"
